# Public URL of the site (used for sitemap, OG and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend). Without these the form works in "dry" mode:
# the message is validated and logged on the server, nothing is sent.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Where messages are delivered (your inbox). Never hard-code it.
CONTACT_TO_EMAIL=
